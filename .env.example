# -----------------------------------------------------------------------------
# Telegram ingestion mode
# -----------------------------------------------------------------------------
# "rsshub"  (default, recommended) — poll each TG channel as an RSS feed from a
#           self-hosted RSSHub. No Telegram API credentials required.
# "userbot" — use telethon userbot for real-time ingestion. Requires TG_API_ID
#           + TG_API_HASH from https://my.telegram.org, plus a phone login.
TG_INGEST_MODE=rsshub

# RSSHub endpoint.
# - Self-hosted via docker-compose: http://rsshub:1200 (default; matches the
#   rsshub service in docker-compose.yml)
# - Public fallback: https://rsshub.app (flaky, rate-limited; not recommended)
RSSHUB_BASE_URL=http://rsshub:1200

# -----------------------------------------------------------------------------
# Telegram userbot (telethon) — ONLY needed when TG_INGEST_MODE=userbot
# -----------------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_USERBOT_PHONE=
TG_USERBOT_SESSION=/app/data/userbot.session

# -----------------------------------------------------------------------------
# Telegram publisher bot (REQUIRED, regardless of ingestion mode)
# -----------------------------------------------------------------------------
# Create a bot with @BotFather → copy token here.
TG_BOT_TOKEN=
# Numeric chat id of the destination (DM, group, or channel).
# Get yours by messaging @userinfobot.
TG_TARGET_CHAT_ID=

# -----------------------------------------------------------------------------
# Storage / logging
# -----------------------------------------------------------------------------
SAFE_MONITOR_DB_PATH=/app/data/safe_monitor.db
LOG_LEVEL=INFO
SAFE_MONITOR_CONFIG=/app/config.yaml
